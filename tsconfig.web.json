{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "wxt/vite-builder-env"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "wxt/browser": ["./web/browser.ts"] }
  },
  "include": ["web", "shared"]
}
