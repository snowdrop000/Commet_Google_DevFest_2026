# Server only. Never prefix secrets with WXT_.
GEMINI_API_KEY=
# developer: Gemini API key / vertex: Google Cloud Application Default Credentials
GEMINI_PROVIDER=developer
# For Vertex AI, use a real project even if Firebase uses the local emulators.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
COMMET_GEMINI_QUOTA_ENABLED=true
COMMET_GEMINI_USER_DAILY=20
COMMET_GEMINI_PROJECT_DAILY=150
# Optional: dedicated Firebase email/password review user, with the commetWebDemo custom claim.
# COMMET_WEB_DEMO_UID=your-review-account-uid
FIREBASE_PROJECT_ID=demo-commet
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
COMMET_DEMO_AI=false

# Public Firebase web app configuration. The emulator uses demo defaults.
WXT_API_BASE_URL=http://127.0.0.1:8765
WXT_FIREBASE_PROJECT_ID=demo-commet
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_APP_ID=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
WXT_GOOGLE_CLIENT_ID=
WXT_EXTENSION_PUBLIC_KEY=
