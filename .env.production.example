# Public extension configuration. Copy to .env.cloud.local and use npm run build:cloud.
# This template identifies the requested Google Cloud project; it does not enable Firebase.
WXT_FIREBASE_PROJECT_ID=vital-charger-422600-u7
WXT_API_BASE_URL=
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_APP_ID=
WXT_FIREBASE_AUTH_DOMAIN=vital-charger-422600-u7.firebaseapp.com
WXT_GOOGLE_CLIENT_ID=
WXT_EXTENSION_PUBLIC_KEY=

# Server runtime configuration belongs in Cloud Run, not in the extension build.
# FIREBASE_PROJECT_ID=vital-charger-422600-u7
# HOST=0.0.0.0
# GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=vital-charger-422600-u7
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.1-flash-lite
# Vertex AI uses the Cloud Run service account; no Gemini API key is needed.
# Do not set emulator host variables or COMMET_DEMO_AI=true in Cloud Run.
