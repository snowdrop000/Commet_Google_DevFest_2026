{
  "name": "commet",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build:api": "esbuild ./server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --tsconfig=tsconfig.api.json --outfile=dist/server.js",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:extension": "wxt",
    "build": "wxt build -b chrome",
    "build:cloud": "wxt build -b chrome --mode cloud",
    "typecheck": "wxt prepare && tsc --noEmit",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "lint": "eslint server shared extension test *.config.ts",
    "format": "prettier --write server shared extension test *.config.ts",
    "test": "vitest run",
    "test:e2e": "WXT_FIREBASE_PROJECT_ID=demo-commet WXT_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099 npm run build && playwright test",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-commet 'vitest run test/firebase.test.ts'",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-commet"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "10.9.1",
    "hono": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "firebase-tools": "^14.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  }
}
